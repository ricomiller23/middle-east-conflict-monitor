# Middle East Conflict Monitor - Environment Configuration
# Copy this file to .env.local for local development. DO NOT commit real secrets to GitHub.

# Database Configuration (Vercel Postgres, Neon, or Supabase Postgres)
# Leave empty to utilize the zero-config in-memory fallback during local UI development
POSTGRES_URL=postgres://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Vercel Cron Security Secret (Passed as Bearer token in cron calls)
# Generate a 64-character random hex string: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
CRON_SECRET=your_generated_64_character_hex_cron_secret_here

# Resend API Configuration for Transactional Email Digests
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_placeholder_api_key_replace_with_yours

# Email Digest Recipient and Verified Sender
DIGEST_RECIPIENT_EMAIL=analyst@example.com
DIGEST_SENDER_EMAIL=alerts@yourdomain.com

# Admin Portal Access Password (Gating /admin)
ADMIN_PASSWORD=replace_with_a_secure_admin_password

# Public Application URL (Used for unsubscribe/pause links in email digests)
NEXT_PUBLIC_APP_URL=https://middle-east-conflict-monitor.vercel.app
